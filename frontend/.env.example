# Copy to `.env.local` for local dev if you need to point at a non-default
# backend. In Vercel, set this in Project Settings -> Environment Variables
# to your deployed backend's public URL (e.g. https://networking-agent-api.fly.dev).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional. Enables the "Continue with Google" button on /login. Get this
# from Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# ID (type "Web application"). Add both http://localhost:3000 and your
# deployed frontend URL under "Authorized JavaScript origins". Must match
# the backend's GOOGLE_CLIENT_ID exactly (same value, both sides).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
