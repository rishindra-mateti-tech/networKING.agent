# Copy to `.env` if you want to pin these yourself. If you don't, the app
# generates and persists random values here automatically on first boot —
# see config.py. Never commit the real `.env` file.

JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Comma-separated list of frontend origins allowed to call the API.
# In production, add your deployed frontend URL, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://networking-agent.vercel.app
CORS_ORIGINS=http://localhost:3000

# Only needed if you're not using the Docker/Fly deployment (which sets
# these automatically to point at the mounted persistent volume).
# DATABASE_URL=sqlite:////data/networking.db
# UPLOADS_DIR=/data/uploads
