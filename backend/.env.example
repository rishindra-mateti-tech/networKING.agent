# Copy to `.env` if you want to pin these yourself. If you don't, the app
# generates and persists random values here automatically on first boot —
# see config.py. Never commit the real `.env` file.

JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Comma-separated list of frontend origins allowed to call the API.
# In production, add your deployed frontend URL, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://networking-s-agent.vercel.app
CORS_ORIGINS=http://localhost:3000

# Defaults to a local SQLite file for local dev. In production (see
# DEPLOY.md), point this at a free hosted Postgres instance (Neon/Supabase)
# instead, since hosts like Render's free tier have no persistent disk and
# would wipe a local SQLite file on every restart.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only needed if you want uploaded screenshots stored somewhere other than
# ./uploads next to the app (not persisted across restarts on hosts with no
# persistent disk -- see the "Known limitation" note in DEPLOY.md).
# UPLOADS_DIR=/data/uploads

# Optional. Enables "Continue with Google" on the login page. Same OAuth
# client ID as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID (from Google
# Cloud Console -> APIs & Services -> Credentials). Without it, /api/auth/google
# responds 503 and the button simply doesn't render on the frontend.
# GOOGLE_CLIENT_ID=
